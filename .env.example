# Shared Atlas cluster connection string (provided by the workshop organizer).
# Example: mongodb+srv://workshop_user:PASSWORD@kfc-loyalty-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Each attendee MUST use a unique database name on the shared cluster.
# Suggested convention: kfc_loyalty_<yourname>  (e.g. kfc_loyalty_niko)
DB_NAME=kfc_loyalty_<yourname>
